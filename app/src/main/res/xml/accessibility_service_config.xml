<?xml version="1.0" encoding="utf-8"?>
<!--
    De propósito, o serviço pede o MÍNIMO (desde a versão 2.0):
    - só recebe eventos do app do YouTube (packageNames);
    - só eventos de mudança de tela, nada de texto digitado;
    - não faz gestos (sem canPerformGestures) e não filtra teclas.
    Apps de banco desconfiam de serviços que vigiam o celular inteiro. Não adicione outros apps aqui.

    settingsActivity: mostra um botão "Configurações" em Acessibilidade > BloqueiaShorts,
    que abre o app mesmo com o ícone escondido pelo próprio celular.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/service_description"
    android:packageNames="com.google.android.youtube"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="100"
    android:settingsActivity="com.bloqueiashorts.MainActivity" />
