<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/sheetContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/sheetIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/accent_container"
            android:importantForAccessibility="no"
            android:padding="18dp"
            android:src="@drawable/ic_dialpad"
            android:tint="@color/accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="Como reabrir o app escondido"
            android:textColor="@color/on_surface"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Com o ícone escondido, o BloqueiaShorts abre por um código secreto no app de telefone. O código é a sua própria senha."
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <!-- Código em destaque -->
        <LinearLayout
            android:id="@+id/codeBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_code"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="*#*#"
                    android:textColor="@color/on_surface"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/codePin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_icon_box"
                    android:backgroundTint="@color/brand"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:text="SUA SENHA"
                    android:textColor="@color/on_brand"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="#*#*"
                    android:textColor="@color/on_surface"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Exemplo: senha 2580 → *#*#2580#*#*"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Passos -->
        <LinearLayout style="@style/StepRow">

            <TextView
                style="@style/StepNumber"
                android:text="1" />

            <TextView
                style="@style/StepText"
                android:text="Abra o app de Telefone (discador)." />
        </LinearLayout>

        <LinearLayout style="@style/StepRow">

            <TextView
                style="@style/StepNumber"
                android:text="2" />

            <TextView
                style="@style/StepText"
                android:text="Digite *#*#, a sua senha e depois #*#*." />
        </LinearLayout>

        <LinearLayout style="@style/StepRow">

            <TextView
                style="@style/StepNumber"
                android:text="3" />

            <TextView
                style="@style/StepText"
                android:text="O ícone do BloqueiaShorts aparece na tela inicial: toque nele para abrir. Não precisa apertar ligar. Ao sair do app, o ícone se esconde de novo." />
        </LinearLayout>

        <!-- Observações -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_code"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info"
                android:tint="@color/accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:lineSpacingExtra="3dp"
                android:text="• Não faz ligação e não fica no histórico.\n• Se você trocar a senha, o código muda junto.\n• Senha errada não abre nada (5 erros = espera de 1 min).\n• Funciona mesmo com o bloqueio pausado, desde que o serviço de Acessibilidade esteja ativo.\n• O app só confere o formato *#*#…#*#*; nenhum número que você liga é lido ou guardado.\n• Remover a senha mostra o ícone de novo automaticamente."
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetCopyCode"
            style="@style/PillButton.Tonal"
            android:layout_marginTop="18dp"
            android:text="Copiar código de reabertura"
            app:icon="@drawable/ic_copy"
            app:iconGravity="textStart" />

        <!-- Xiaomi: precisa liberar a abertura em segundo plano -->
        <LinearLayout
            android:id="@+id/xiaomiBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_code"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Xiaomi / Redmi / Poco"
                android:textColor="@color/on_surface"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="Opcional: permitindo “Exibir janelas pop-up enquanto executado em segundo plano” em Outras permissões, o botão “Abrir” do cartão também funciona. Sem isso, use o ícone que aparece na tela inicial."
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnXiaomiPerms"
                style="@style/PillButton.Tonal"
                android:layout_marginTop="12dp"
                android:text="Abrir Outras permissões" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetPrimary"
            style="@style/PillButton"
            android:layout_marginTop="22dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetSecondary"
            style="@style/PillButton.Text"
            android:layout_marginTop="4dp"
            android:text="Cancelar" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
