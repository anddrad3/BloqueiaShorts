<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/sheetContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/sheetIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo_shape" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="Como o app funciona"
            android:textColor="@color/on_surface"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="Tudo acontece no seu celular. Nada é coletado ou enviado."
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <!-- 1. Bloqueio -->
        <LinearLayout style="@style/HelpBlock">
            <ImageView style="@style/RowIconBox" android:importantForAccessibility="no" android:src="@drawable/ic_shield_check" />
            <LinearLayout style="@style/HelpTexts">
                <TextView style="@style/HelpTitle" android:text="O bloqueio" />
                <TextView
                    style="@style/HelpBody"
                    android:text="O app usa o serviço de Acessibilidade do Android para ver qual tela está aberta. Quando aparece um vídeo curto, ele aperta “voltar” sozinho:\n• YouTube Shorts e Instagram Reels: volta ao abrir o player.\n• TikTok e Kwai: vai para a tela inicial.\n• No navegador: volta ao abrir links de Shorts, Reels ou TikTok." />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Senha -->
        <LinearLayout style="@style/HelpBlock">
            <ImageView style="@style/RowIconBox" android:importantForAccessibility="no" android:src="@drawable/ic_key" />
            <LinearLayout style="@style/HelpTexts">
                <TextView style="@style/HelpTitle" android:text="A senha" />
                <TextView
                    style="@style/HelpBody"
                    android:text="Opcional, mas recomendada. Com senha, é preciso digitá-la para pausar ou ativar o bloqueio, esconder o ícone ou remover a senha. Depois de 5 erros seguidos, o app espera 1 minuto." />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Proteção -->
        <LinearLayout style="@style/HelpBlock">
            <ImageView style="@style/RowIconBox" android:importantForAccessibility="no" android:src="@drawable/ic_lock" />
            <LinearLayout style="@style/HelpTexts">
                <TextView style="@style/HelpTitle" android:text="Proteção contra desligar" />
                <TextView
                    style="@style/HelpBody"
                    android:text="Com senha e bloqueio ligado, o app tira você das telas do sistema onde daria para desligá-lo ou desinstalá-lo (Acessibilidade, Apps, desinstalação). Assim a senha não pode ser driblada.\n\nPrecisa mexer nessas telas? Pause o bloqueio com a senha: a proteção desliga junto. Ao ativar de novo, ela volta." />
            </LinearLayout>
        </LinearLayout>

        <!-- 5. Modo invisível -->
        <LinearLayout style="@style/HelpBlock">
            <ImageView style="@style/RowIconBox.Accent" android:importantForAccessibility="no" android:src="@drawable/ic_eye_off" />
            <LinearLayout style="@style/HelpTexts">
                <TextView style="@style/HelpTitle" android:text="Modo invisível" />
                <TextView
                    style="@style/HelpBody"
                    android:text="Esconde o ícone da tela inicial. Para abrir o app de novo, digite *#*#SUA SENHA#*#* no app de Telefone. O bloqueio continua funcionando normalmente com o ícone escondido." />
            </LinearLayout>
        </LinearLayout>

        <!-- 6. Problemas -->
        <LinearLayout style="@style/HelpBlock">
            <ImageView style="@style/RowIconBox.Accent" android:importantForAccessibility="no" android:src="@drawable/ic_warning" />
            <LinearLayout style="@style/HelpTexts">
                <TextView style="@style/HelpTitle" android:text="Se parar de bloquear" />
                <TextView
                    style="@style/HelpBody"
                    android:text="Alguns celulares (Xiaomi, Samsung) desligam apps em segundo plano. Em Informações do app, ligue “Inicialização automática” e coloque a bateria em “Sem restrições”. Se mesmo assim parar, desligue e ligue o BloqueiaShorts em Acessibilidade." />
            </LinearLayout>
        </LinearLayout>

        <!-- 7. Esqueci a senha -->
        <LinearLayout style="@style/HelpBlock">
            <ImageView style="@style/RowIconBox.Accent" android:importantForAccessibility="no" android:src="@drawable/ic_info" />
            <LinearLayout style="@style/HelpTexts">
                <TextView style="@style/HelpTitle" android:text="Esqueci a senha" />
                <TextView
                    style="@style/HelpBody"
                    android:text="Reinicie o celular em modo de segurança (segure o botão de desligar e depois segure “Desligar”). Nesse modo o app não roda e pode ser desinstalado. Também dá para desinstalar por um computador com adb." />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetPrimary"
            style="@style/PillButton"
            android:layout_marginTop="24dp"
            android:text="Entendi" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
