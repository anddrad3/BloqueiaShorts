<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/sheetContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/sheetIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo_shape" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="Como o app funciona"
            android:textColor="@color/on_surface"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="Tudo acontece no seu celular. Nada é coletado ou enviado."
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <LinearLayout style="@style/HelpBlock">
            <ImageView style="@style/RowIconBox" android:importantForAccessibility="no" android:src="@drawable/ic_shield_check" />
            <LinearLayout style="@style/HelpTexts">
                <TextView style="@style/HelpTitle" android:text="O bloqueio" />
                <TextView
                    style="@style/HelpBody"
                    android:text="O app usa a Acessibilidade do Android, mas observa SÓ o app do YouTube. Quando o player de Shorts abre, ele aperta “voltar” sozinho. Vídeos normais, busca e inscrições continuam livres." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/HelpBlock">
            <ImageView style="@style/RowIconBox" android:importantForAccessibility="no" android:src="@drawable/ic_key" />
            <LinearLayout style="@style/HelpTexts">
                <TextView style="@style/HelpTitle" android:text="A senha" />
                <TextView
                    style="@style/HelpBody"
                    android:text="Opcional. Com senha, é preciso digitá-la para pausar ou ativar o bloqueio, desligar para o banco ou remover a senha. Depois de 5 erros seguidos, o app espera 1 minuto." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/HelpBlock">
            <ImageView style="@style/RowIconBox.Accent" android:importantForAccessibility="no" android:src="@drawable/ic_lock" />
            <LinearLayout style="@style/HelpTexts">
                <TextView style="@style/HelpTitle" android:text="Apps de banco" />
                <TextView
                    style="@style/HelpBody"
                    android:text="Esta versão foi feita para não assustar os bancos: não lê o que você digita, não vê outros apps e não precisa de modo desenvolvedor nem de computador. Mesmo assim, alguns bancos recusam qualquer Acessibilidade de fora da Play Store. Se o seu recusar, toque em “Desligar para usar app de banco” e religue depois." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/HelpBlock">
            <ImageView style="@style/RowIconBox.Accent" android:importantForAccessibility="no" android:src="@drawable/ic_info" />
            <LinearLayout style="@style/HelpTexts">
                <TextView style="@style/HelpTitle" android:text="Por que o app mudou (versão 2.0)" />
                <TextView
                    style="@style/HelpBody"
                    android:text="As versões 1.x vigiavam o discador, as Configurações e vários apps, e eram instaladas com o modo desenvolvedor ligado. Para um app de banco, isso parece um golpe de “mão fantasma” — e vários bancos pararam de abrir. A 2.0 tira tudo isso: bloqueia só os Shorts do YouTube, o ícone é escondido pelo próprio celular e não existe mais proteção contra desinstalar." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/HelpBlock">
            <ImageView style="@style/RowIconBox.Accent" android:importantForAccessibility="no" android:src="@drawable/ic_eye_off" />
            <LinearLayout style="@style/HelpTexts">
                <TextView style="@style/HelpTitle" android:text="Esconder o ícone" />
                <TextView
                    style="@style/HelpBody"
                    android:text="Use a opção de ocultar apps do seu celular (Samsung, Xiaomi, Oppo e outros têm). Para abrir com o ícone escondido: Acessibilidade → BloqueiaShorts → Configurações." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/HelpBlock">
            <ImageView style="@style/RowIconBox.Accent" android:importantForAccessibility="no" android:src="@drawable/ic_warning" />
            <LinearLayout style="@style/HelpTexts">
                <TextView style="@style/HelpTitle" android:text="Se parar de bloquear" />
                <TextView
                    style="@style/HelpBody"
                    android:text="Alguns celulares (Xiaomi, Samsung) desligam apps em segundo plano. Coloque a bateria em “Sem restrições” e, na Xiaomi, ligue “Inicialização automática”. Se mesmo assim parar, desligue e ligue o BloqueiaShorts em Acessibilidade." />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetPrimary"
            style="@style/PillButton"
            android:layout_marginTop="24dp"
            android:text="Entendi" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
