<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/sheetContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/sheetIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/state_off_container"
            android:importantForAccessibility="no"
            android:padding="18dp"
            android:src="@drawable/ic_lock"
            android:tint="@color/state_off" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="“Configuração restrita”"
            android:textColor="@color/on_surface"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="No Android 13 ou mais novo, apps instalados fora de uma loja precisam ser liberados uma vez antes de usar a Acessibilidade. Não precisa de computador nem de modo desenvolvedor."
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <LinearLayout style="@style/HelpBlock">
            <ImageView style="@style/RowIconBox" android:importantForAccessibility="no" android:src="@drawable/ic_shield_check" />
            <LinearLayout style="@style/HelpTexts">
                <TextView style="@style/HelpTitle" android:text="Samsung, Motorola, Pixel e outros" />
                <TextView
                    style="@style/HelpBody"
                    android:text="1. Tente ligar o BloqueiaShorts em Acessibilidade uma vez (vai aparecer o aviso).\n2. Toque em “Abrir informações do app” aqui embaixo.\n3. Toque nos ⋮ (canto superior direito) → “Permitir configurações restritas”.\n4. Volte em Acessibilidade e ligue a chave." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/HelpBlock">
            <ImageView style="@style/RowIconBox" android:importantForAccessibility="no" android:src="@drawable/ic_info" />
            <LinearLayout style="@style/HelpTexts">
                <TextView style="@style/HelpTitle" android:text="Xiaomi, Redmi, Poco" />
                <TextView
                    style="@style/HelpBody"
                    android:text="1. Tente ligar em Acessibilidade uma vez.\n2. Toque em “Abrir informações do app” aqui embaixo.\n3. Toque nos ⋮ → “Informações do app” (abre a tela original do Android).\n4. Nessa tela, toque nos ⋮ de novo → “Permitir configurações restritas”." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/HelpBlock">
            <ImageView style="@style/RowIconBox.Accent" android:importantForAccessibility="no" android:src="@drawable/ic_warning" />
            <LinearLayout style="@style/HelpTexts">
                <TextView style="@style/HelpTitle" android:text="Não ative o modo desenvolvedor" />
                <TextView
                    style="@style/HelpBody"
                    android:text="As versões antigas ensinavam a instalar pelo computador com depuração USB ou Wi-Fi. Não faça isso: com as Opções do desenvolvedor ligadas, muitos apps de banco param de abrir. Se você ativou antes, desligue a chave no topo de Opções do desenvolvedor." />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetPrimary"
            style="@style/PillButton"
            android:layout_marginTop="24dp"
            android:text="Abrir informações do app" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetSecondary"
            style="@style/PillButton.Text"
            android:layout_marginTop="4dp"
            android:text="Fechar" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
