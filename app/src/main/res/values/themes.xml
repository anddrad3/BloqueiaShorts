<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.BloqueiaShorts" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/on_brand_container</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryContainer">@color/accent_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface_variant</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorControlNormal">@color/on_surface</item>

        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_bars</item>

        <item name="android:windowAnimationStyle">@style/WindowAnim</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.BloqueiaShorts.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.BloqueiaShorts.Sheet</item>
        <item name="snackbarStyle">@style/Snackbar</item>
    </style>

    <!-- Transição suave ao abrir/fechar a tela -->
    <style name="WindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_exit</item>
    </style>

    <!-- Diálogos com cantos bem arredondados e animação de entrada -->
    <style name="ThemeOverlay.BloqueiaShorts.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/Shape.Dialog</item>
        <item name="android:windowAnimationStyle">@style/DialogAnim</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
    </style>

    <style name="DialogAnim" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_out</item>
    </style>

    <style name="Shape.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ThemeOverlay.BloqueiaShorts.Sheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Sheet</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>

    <style name="Sheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearanceOverlay">@style/Shape.Sheet</item>
    </style>

    <style name="Shape.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Snackbar" parent="Widget.Material3.Snackbar">
        <item name="shapeAppearance">@style/Shape.Snackbar</item>
    </style>

    <style name="Shape.Snackbar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
